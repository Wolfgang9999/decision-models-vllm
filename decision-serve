#!/usr/bin/env bash
# decision-serve MODEL [vllm serve options...]
# Serves a Base Labs decision model (baselabs/joey-1, baselabs/elephant-1, baselabs/mammoth-1) with the settings
# these models need; any extra option is passed to `vllm serve` and overrides the defaults below.
# The attention backend is picked per GPU (Triton + FlashAttention-2 prefill below SM 9.0, FlashInfer from SM 9.0);
# pass --attention-backend to override.
set -euo pipefail
MODEL=${1:-${MODEL:-baselabs/elephant-1}}
[ $# -gt 0 ] && shift
NAME=${MODEL_NAME:-${MODEL##*/}}
case "$NAME" in
  *joey*) TOKENS=${MAX_NUM_BATCHED_TOKENS:-65536} ;;   # small model: larger prefill steps measured faster
  *)      TOKENS=${MAX_NUM_BATCHED_TOKENS:-32768} ;;
esac
exec vllm serve "$MODEL" \
  --served-model-name "$NAME" \
  --host "${HOST:-0.0.0.0}" --port "${PORT:-8000}" \
  --dtype bfloat16 --language-model-only \
  --max-model-len 16384 \
  --max-num-batched-tokens "$TOKENS" \
  --max-num-seqs "${MAX_NUM_SEQS:-64}" \
  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION:-0.90}" \
  --enable-prefix-caching \
  --no-enable-log-requests \
  "$@"
